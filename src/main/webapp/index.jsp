<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{
  font-family:'Poppins',sans-serif;
  background:linear-gradient(135deg,#0f2027,#203a43,#2c5364);
  color:#fff;
}
.navbar{
  display:flex;justify-content:space-between;align-items:center;
  padding:15px 30px;background:rgba(0,0,0,0.3);
  backdrop-filter:blur(10px);
}
.navbar a{color:#fff;text-decoration:none;margin:0 10px;}
.container{padding:30px;}
.card{
  background:rgba(255,255,255,0.1);
  backdrop-filter:blur(10px);
  padding:20px;border-radius:12px;
  box-shadow:0 0 15px rgba(0,0,0,0.3);
  transition:.3s;
}
.card:hover{transform:translateY(-5px)}
.grid{display:flex;gap:20px;flex-wrap:wrap;justify-content:center;}
button{
  padding:10px 15px;border:none;border-radius:8px;
  background:#00c6ff;color:#fff;cursor:pointer;
}
button:hover{background:#0072ff}
input{
  padding:10px;border-radius:8px;border:none;width:250px;
}
.table{
  width:80%;margin:auto;border-collapse:collapse;
}
.table th,.table td{
  padding:12px;background:#fff;color:#000;
}
</style>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>

</body>
</html>